rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The signed-in user's own verified email address, lowercased.
    function hasVerifiedEmail() {
      return request.auth != null &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true;
    }

    function ownEmail() {
      return request.auth.token.email.lower();
    }

    // User data - only the authenticated user can read/write their own data
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile - display info shown to people you share with
    match /userProfiles/{userId} {
      // Anyone authenticated can fetch one profile by uid, but not list them
      allow get: if request.auth != null;
      // Only the user can write their own profile, with their own verified email
      allow create, update: if hasVerifiedEmail() &&
                               request.auth.uid == userId &&
                               request.resource.data.email == ownEmail();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Shared buckets - accessible by all owners, writable by writers only
    match /sharedBuckets/{bucketId} {
      // Helper function to check if user has any access
      function hasAccess() {
        return request.auth != null && 
               resource.data.ownerIds != null && 
               request.auth.uid in resource.data.ownerIds;
      }
      
      // Helper function to check if user has write access
      function hasWriteAccess() {
        return request.auth != null && 
               resource.data.writerIds != null && 
               request.auth.uid in resource.data.writerIds;
      }
      
      // Allow read if user is in ownerIds array (all users with any access)
      allow read: if hasAccess();
      // Allow update if user is in ownerIds (any user can update - for leaving or content)
      // Client code enforces that read-only users can only remove themselves
      allow update: if hasAccess();
      // Allow delete if user has write access OR is the last person
      allow delete: if request.auth != null && (
        hasWriteAccess() ||
        (resource.data.ownerIds != null && resource.data.ownerIds.size() == 1)
      );
      // Allow create if user is authenticated and adds themselves as writer
      allow create: if request.auth != null && 
                       request.resource.data.writerIds != null &&
                       request.auth.uid in request.resource.data.writerIds;
    }
    
    // Email to user ID lookup (for sharing by email).
    // Replaces the old emailLookup collection, which anyone could write to point
    // another person's address at their own account. emailLookup now falls
    // through to the deny-all rule below, so its old entries are never read.
    match /emailIndex/{email} {
      // Anyone authenticated can look up one exact address, but not list them
      allow get: if request.auth != null;
      // Only the verified owner of an address can map it, and only to themselves
      allow create, update: if hasVerifiedEmail() &&
                               email == ownEmail() &&
                               request.resource.data.email == email &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'updatedAt']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
